#!/usr/bin/env python3
# devtools/fakes/fake-sysbus — the services of the gate's PRIVATE system
# bus (DBUS_SYSTEM_BUS_ADDRESS), so the battery exercises the plugin's real
# D-Bus paths without ever touching the host's lights or sensors:
#
# - org.freedesktop.login1: the light paths call Session.SetBrightness;
#   here it writes the fake device under $AW_BACKLIGHT_DIR/<name>/brightness
#   ("backlight") or $AW_LEDS_DIR/<name>/brightness ("leds", the
#   keyboard's) and logs the call to $AW_LOGIND_LOG. Any session path
#   answers (auto, session-N, _3N).
# - net.hadess.SensorProxy (iio-sensor-proxy): an ambient light sensor in
#   lux whose reading is the number in $AW_ALS_FILE (no file: no sensor).
#   LightLevel moves only while a client holds a claim, as the daemon's
#   does: the file is polled and a change is announced by PropertiesChanged.
#   ClaimLight / ReleaseLight are logged to $AW_LOGIND_LOG too.
# - org.bluez (bluetoothd): an ObjectManager at / over one adapter (hci0,
#   powered) and three devices — "Gate Buds" (headphones, paired, a 80 %
#   battery), "Gate Mouse" (paired, connected) and "Stranger" (seen, never
#   paired). Powered is settable (off drops every connection); Connect
#   connects after 300 ms (NotReady while off), Disconnect after 400 ms;
#   each is logged to $AW_LOGIND_LOG. The gate's own interface
#   (org.awesome.Gate at /) emits a headset transport's Volume change, as
#   bluetoothd does when the headset's own buttons move it, moves a
#   battery, and fails a device's next Connect with a given error.
import os
import sys
import warnings

from gi.repository import Gio, GLib

warnings.filterwarnings("ignore", category=DeprecationWarning)  # register_object: fine for a fake

BUS_NAME = "org.freedesktop.login1"
XML = """
<node>
  <interface name="org.freedesktop.login1.Session">
    <method name="SetBrightness">
      <arg type="s" name="subsystem" direction="in"/>
      <arg type="s" name="name" direction="in"/>
      <arg type="u" name="brightness" direction="in"/>
    </method>
  </interface>
  <interface name="org.freedesktop.login1.Manager">
    <method name="GetSession">
      <arg type="s" name="id" direction="in"/>
      <arg type="o" name="path" direction="out"/>
    </method>
  </interface>
</node>
"""
BACKLIGHT = os.environ.get("AW_BACKLIGHT_DIR", "")
LEDS = os.environ.get("AW_LEDS_DIR", "")
LOG = os.environ.get("AW_LOGIND_LOG", "")
ALS = os.environ.get("AW_ALS_FILE", "")
NODE = Gio.DBusNodeInfo.new_for_xml(XML)
SENSOR_XML = """
<node>
  <interface name="net.hadess.SensorProxy">
    <method name="ClaimLight"/>
    <method name="ReleaseLight"/>
    <property name="HasAmbientLight" type="b" access="read"/>
    <property name="LightLevelUnit" type="s" access="read"/>
    <property name="LightLevel" type="d" access="read"/>
  </interface>
</node>
"""
SENSOR = Gio.DBusNodeInfo.new_for_xml(SENSOR_XML).interfaces[0]
SENSOR_PATH = "/net/hadess/SensorProxy"
claims = set()
reading = None  # the lux last announced


def log(line):
    if LOG:
        with open(LOG, "a") as f:
            f.write(line + "\n")


def on_call(conn, sender, path, iface, method, params, invocation):
    if method == "SetBrightness":
        subsystem, name, value = params.unpack()
        root = {"backlight": BACKLIGHT, "leds": LEDS}.get(subsystem, "")
        target = os.path.join(root, name, "brightness")
        if not root or "/" in name or not os.path.exists(target):
            invocation.return_dbus_error("org.freedesktop.login1.NoSuchDevice", f"no {subsystem} {name}")
            return
        with open(target, "w") as f:
            f.write(str(value))
        log(f"SetBrightness {path} {name} {value}")
        invocation.return_value(None)
    elif method == "GetSession":
        invocation.return_value(GLib.Variant("(o)", ("/org/freedesktop/login1/session/auto",)))
    else:
        invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", method)


def lux():
    try:
        with open(ALS) as f:
            return float(f.read().strip())
    except (OSError, ValueError):
        return 0.0


def on_sensor_call(conn, sender, path, iface, method, params, invocation):
    global reading
    if method == "ClaimLight":
        claims.add(sender)
        reading = lux()
        log("ClaimLight")
    elif method == "ReleaseLight":
        claims.discard(sender)
        log("ReleaseLight")
    else:
        invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", method)
        return
    invocation.return_value(None)


def on_sensor_get(conn, sender, path, iface, prop):
    if prop == "HasAmbientLight":
        return GLib.Variant("b", bool(ALS) and os.path.exists(ALS))
    if prop == "LightLevelUnit":
        return GLib.Variant("s", "lux")
    if prop == "LightLevel":
        return GLib.Variant("d", reading if reading is not None else 0.0)
    return None


def poll_sensor(conn):
    global reading
    if claims and ALS:
        now = lux()
        if now != reading:
            reading = now
            conn.emit_signal(None, SENSOR_PATH, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                             GLib.Variant("(sa{sv}as)", ("net.hadess.SensorProxy", {"LightLevel": GLib.Variant("d", now)}, [])))
    return True


BLUEZ_XML = """
<node>
  <interface name="org.freedesktop.DBus.ObjectManager">
    <method name="GetManagedObjects">
      <arg type="a{oa{sa{sv}}}" name="objects" direction="out"/>
    </method>
    <signal name="InterfacesAdded"><arg type="o"/><arg type="a{sa{sv}}"/></signal>
    <signal name="InterfacesRemoved"><arg type="o"/><arg type="as"/></signal>
  </interface>
  <interface name="org.awesome.Gate">
    <method name="EmitVolume"><arg type="q" name="volume" direction="in"/></method>
    <method name="SetBattery"><arg type="s" name="name" direction="in"/><arg type="y" name="percent" direction="in"/></method>
    <method name="FailNext"><arg type="s" name="name" direction="in"/><arg type="s" name="error" direction="in"/><arg type="s" name="message" direction="in"/></method>
  </interface>
  <interface name="org.bluez.Adapter1">
    <property name="Powered" type="b" access="readwrite"/>
    <property name="Alias" type="s" access="read"/>
  </interface>
  <interface name="org.bluez.Device1">
    <method name="Connect"/>
    <method name="Disconnect"/>
    <property name="Alias" type="s" access="read"/>
    <property name="Icon" type="s" access="read"/>
    <property name="Paired" type="b" access="read"/>
    <property name="Connected" type="b" access="read"/>
    <property name="Adapter" type="o" access="read"/>
  </interface>
  <interface name="org.bluez.Battery1">
    <property name="Percentage" type="y" access="read"/>
  </interface>
</node>
"""
BLUEZ = {i.name: i for i in Gio.DBusNodeInfo.new_for_xml(BLUEZ_XML).interfaces}
HCI = "/org/bluez/hci0"
adapter = {"Powered": True, "Alias": "gate"}
devices = {  # path -> its Device1 values, and Battery1's (None: none)
    HCI + "/dev_00_00_00_00_00_01": [{"Alias": "Gate Buds", "Icon": "audio-headphones", "Paired": True, "Connected": False}, 80],
    HCI + "/dev_00_00_00_00_00_02": [{"Alias": "Gate Mouse", "Icon": "input-mouse", "Paired": True, "Connected": True}, None],
    HCI + "/dev_00_00_00_00_00_03": [{"Alias": "Stranger", "Icon": "phone", "Paired": False, "Connected": False}, None],
}
SIGS = {"Alias": "s", "Icon": "s", "Paired": "b", "Connected": "b", "Powered": "b"}
fail_next = {}  # alias -> (error name, message): its next Connect answers that


def changed(conn, path, iface, props):
    conn.emit_signal(None, path, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                     GLib.Variant("(sa{sv}as)", (iface, {k: GLib.Variant(SIGS.get(k, "y"), v) for k, v in props.items()}, [])))


def device_props(path):
    values, _ = devices[path]
    out = {k: GLib.Variant(SIGS[k], v) for k, v in values.items()}
    out["Adapter"] = GLib.Variant("o", HCI)
    return out


def on_bluez_call(conn, sender, path, iface, method, params, invocation):
    if method == "GetManagedObjects":
        objs = {HCI: {"org.bluez.Adapter1": {k: GLib.Variant(SIGS.get(k, "s"), v) for k, v in adapter.items()}}}
        for p, (_, battery) in devices.items():
            objs[p] = {"org.bluez.Device1": device_props(p)}
            if battery is not None:
                objs[p]["org.bluez.Battery1"] = {"Percentage": GLib.Variant("y", battery)}
        invocation.return_value(GLib.Variant("(a{oa{sa{sv}}})", (objs,)))
    elif method == "EmitVolume":
        conn.emit_signal(None, HCI + "/dev_00_00_00_00_00_01/sep1/fd0", "org.freedesktop.DBus.Properties", "PropertiesChanged",
                         GLib.Variant("(sa{sv}as)", ("org.bluez.MediaTransport1", {"Volume": GLib.Variant("q", params.unpack()[0])}, [])))
        invocation.return_value(None)
    elif method == "SetBattery":
        name, pct = params.unpack()
        for p, entry in devices.items():
            if entry[0]["Alias"] == name:
                entry[1] = pct
                changed(conn, p, "org.bluez.Battery1", {"Percentage": pct})
        invocation.return_value(None)
    elif method == "FailNext":
        name, error, message = params.unpack()
        fail_next[name] = (error, message)
        invocation.return_value(None)
    elif method in ("Connect", "Disconnect"):
        values = devices[path][0]
        log(f"{method} {values['Alias']}")
        if method == "Connect" and not adapter["Powered"]:
            invocation.return_dbus_error("org.bluez.Error.NotReady", "Resource Not Ready")
            return
        if method == "Connect" and values["Alias"] in fail_next:
            error, message = fail_next.pop(values["Alias"])

            def refuse():
                invocation.return_dbus_error(error, message)
                return False
            GLib.timeout_add(300, refuse)
            return

        def settle():
            if values["Connected"] != (method == "Connect"):
                values["Connected"] = method == "Connect"
                changed(conn, path, "org.bluez.Device1", {"Connected": values["Connected"]})
            invocation.return_value(None)
            return False
        GLib.timeout_add(300 if method == "Connect" else 400, settle)
    else:
        invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", method)


def on_bluez_get(conn, sender, path, iface, prop):
    if iface == "org.bluez.Adapter1":
        return GLib.Variant(SIGS.get(prop, "s"), adapter[prop])
    if iface == "org.bluez.Device1":
        return device_props(path).get(prop)
    if iface == "org.bluez.Battery1" and devices[path][1] is not None:
        return GLib.Variant("y", devices[path][1])
    return None


def on_bluez_set(conn, sender, path, iface, prop, value):
    if iface != "org.bluez.Adapter1" or prop != "Powered":
        return False
    on = value.unpack()
    log(f"Powered {int(on)}")
    if adapter["Powered"] != on:
        adapter["Powered"] = on
        changed(conn, HCI, "org.bluez.Adapter1", {"Powered": on})
        if not on:  # a radio off drops every connection
            for p, (values, _) in devices.items():
                if values["Connected"]:
                    values["Connected"] = False
                    changed(conn, p, "org.bluez.Device1", {"Connected": False})
    return True


def bluez_start(conn):
    conn.register_object("/", BLUEZ["org.freedesktop.DBus.ObjectManager"], on_bluez_call)
    conn.register_object("/", BLUEZ["org.awesome.Gate"], on_bluez_call)
    conn.register_object(HCI, BLUEZ["org.bluez.Adapter1"], on_bluez_call, on_bluez_get, on_bluez_set)
    for p, (_, battery) in devices.items():
        conn.register_object(p, BLUEZ["org.bluez.Device1"], on_bluez_call, on_bluez_get, None)
        if battery is not None:
            conn.register_object(p, BLUEZ["org.bluez.Battery1"], on_bluez_call, on_bluez_get, None)
    Gio.bus_own_name_on_connection(conn, "org.bluez", Gio.BusNameOwnerFlags.NONE, None, None)


def main():
    addr = os.environ.get("DBUS_SYSTEM_BUS_ADDRESS")
    if not addr:
        sys.exit("fake-sysbus: DBUS_SYSTEM_BUS_ADDRESS is not set (refusing the real system bus)")
    conn = Gio.DBusConnection.new_for_address_sync(
        addr, Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION, None, None)
    conn.register_object("/org/freedesktop/login1", NODE.interfaces[1], on_call)
    # the plugin addresses its own session explicitly when its cgroup names
    # one, else "auto": register both shapes it can produce
    session = NODE.interfaces[0]
    conn.register_object("/org/freedesktop/login1/session/auto", session, on_call)
    for line in open("/proc/self/cgroup"):
        mark = line.rfind("session-")
        if mark >= 0 and line.strip().endswith(".scope"):
            sid = line.strip()[mark + len("session-"):-len(".scope")]
            if sid.isdigit():
                conn.register_object(f"/org/freedesktop/login1/session/{sid}", session, on_call)
    Gio.bus_own_name_on_connection(conn, BUS_NAME, Gio.BusNameOwnerFlags.NONE, None, None)
    conn.register_object(SENSOR_PATH, SENSOR, on_sensor_call, on_sensor_get, None)
    Gio.bus_own_name_on_connection(conn, "net.hadess.SensorProxy", Gio.BusNameOwnerFlags.NONE, None, None)
    bluez_start(conn)
    GLib.timeout_add(100, poll_sensor, conn)
    GLib.MainLoop().run()


main()
