#!/usr/bin/env bash
set -u

LOG=${AW_WPCTL_LOG:?}
printf '%s\n' "$*" >> "$LOG"
if [[ -n "${AW_WPCTL_HANG_FILE:-}" && -e "$AW_WPCTL_HANG_FILE" ]]; then
	printf '%s\n' "$$" > "${AW_WPCTL_HANG_FILE}.pid"
	exec sleep 30
fi

# The two nodes' state: the sink's level (AW_WPCTL_LEVEL_FILE, written by
# the gate for a level "set elsewhere" and by an absolute set; else 0.56)
# and the muted nodes (AW_WPCTL_MUTES_FILE's words "sink" and "source";
# absent, the source alone). A relative step leaves the level: the step
# checks read the command. Two sinks, 41 and 42, the default 41 until
# set-default writes AW_WPCTL_DEFAULT_FILE.
level() {
	local l=0.56
	[[ -n "${AW_WPCTL_LEVEL_FILE:-}" && -s "$AW_WPCTL_LEVEL_FILE" ]] && l="$(<"$AW_WPCTL_LEVEL_FILE")"
	printf '%s' "$l"
}
muted() { # muted <sink|source>
	if [[ -n "${AW_WPCTL_MUTES_FILE:-}" && -e "$AW_WPCTL_MUTES_FILE" ]]; then
		grep -qxF "$1" "$AW_WPCTL_MUTES_FILE"
	else
		[[ $1 == source ]]
	fi
}
mute() { # mute <sink|source> <0|1|toggle>
	[[ -n "${AW_WPCTL_MUTES_FILE:-}" ]] || return 0
	local want=$2 n out=""
	if [[ $want == toggle ]]; then muted "$1" && want=0 || want=1; fi
	for n in sink source; do
		if [[ $n == "$1" ]]; then [[ $want == 1 ]] && out+="$n"$'\n'; elif muted "$n"; then out+="$n"$'\n'; fi
	done
	printf '%s' "$out" > "$AW_WPCTL_MUTES_FILE"
}

default_sink() {
	local d=41
	[[ -n "${AW_WPCTL_DEFAULT_FILE:-}" && -s "$AW_WPCTL_DEFAULT_FILE" ]] && d="$(<"$AW_WPCTL_DEFAULT_FILE")"
	printf '%s' "$d"
}
star() { [[ "$(default_sink)" == "$1" ]] && printf '*' || printf ' '; }

case "${1:-}" in
status)
	# the tree as WirePlumber prints it: Clients first, then Audio
	cat <<-EOF
	PipeWire 'pipewire-0' [1.4.9, gate@gate, cookie:1]
	 └─ Clients:
	        33. WirePlumber                         [1.4.9, gate@gate, pid:1]

	Audio
	 ├─ Devices:
	 │      40. Gate Audio                          [alsa]
	 │
	 ├─ Sinks:
	 │  $(star 41)   41. Gate Speakers                       [vol: $(level)]
	 │  $(star 42)   42. Gate Headset                        [vol: 0.80]
	 │
	 ├─ Sources:
	 │  *   43. Gate Microphone                     [vol: 1.00]
	 │
	 ├─ Filters:
	 │
	 └─ Streams:

	Video
	 ├─ Devices:
	 │
	 └─ Streams:
	EOF
	;;
set-default)
	[[ "$*" =~ ^set-default\ (41|42)$ ]] || exit 64
	[[ -n "${AW_WPCTL_DEFAULT_FILE:-}" ]] && printf '%s\n' "${BASH_REMATCH[1]}" > "$AW_WPCTL_DEFAULT_FILE"
	;;
set-volume)
	# a step is 5%; presses during a set accumulate into the next one
	# (N*5%, capped at 100%); the limit is 1.0, or the level past it. The
	# panel sets the level itself, 0.00..1.00.
	if [[ "$*" =~ ^set-volume\ @DEFAULT_AUDIO_SINK@\ (0\.[0-9]{2}|1\.00)$ ]]; then
		[[ -n "${AW_WPCTL_LEVEL_FILE:-}" ]] && printf '%s\n' "${BASH_REMATCH[1]}" > "$AW_WPCTL_LEVEL_FILE"
	elif [[ ! "$*" =~ ^set-volume\ -l\ (1\.0|[1-9]\.[0-9]{3})\ @DEFAULT_AUDIO_SINK@\ (5|[1-9][05]|100)%\+$ && ! "$*" =~ ^set-volume\ @DEFAULT_AUDIO_SINK@\ (5|[1-9][05]|100)%-$ ]]; then
		exit 64
	fi
	sleep 0.05
	;;
set-mute)
	[[ "$*" =~ ^set-mute\ @DEFAULT_AUDIO_(SINK|SOURCE)@\ (0|1|toggle)$ ]] || exit 64
	node=sink
	[[ ${BASH_REMATCH[1]} == SOURCE ]] && node=source
	mute "$node" "${BASH_REMATCH[2]}"
	;;
get-volume)
	if [[ -n "${AW_WPCTL_FLOOD_FILE:-}" && -e "$AW_WPCTL_FLOOD_FILE" ]]; then
		# The reader must stop this producer at its retained-output cap: it
		# closes the pipe (recorded below, SIGPIPE ignored so the loop sees
		# EPIPE) and kills the child; either way it is gone, not running to
		# a timeout.
		trap '' PIPE
		printf '%s\n' "$$" > "${AW_WPCTL_FLOOD_FILE}.pid"
		while printf 'Volume: 0.56\n' 2>/dev/null; do :; done
		printf 'closed\n' > "${AW_WPCTL_FLOOD_FILE}.closed"
		exit 0
	fi
	case "${2:-}" in
	"@DEFAULT_AUDIO_SINK@") printf 'Volume: %s%s\n' "$(level)" "$(muted sink && printf ' [MUTED]')" ;;
	"@DEFAULT_AUDIO_SOURCE@") printf 'Volume: 1.00%s\n' "$(muted source && printf ' [MUTED]')" ;;
	*) exit 64 ;;
	esac
	;;
*) exit 64 ;;
esac
