#!/usr/bin/env bash
set -u

LOG=${AW_WPCTL_LOG:?}
printf '%s\n' "$*" >> "$LOG"
if [[ -n "${AW_WPCTL_HANG_FILE:-}" && -e "$AW_WPCTL_HANG_FILE" ]]; then
	printf '%s\n' "$$" > "${AW_WPCTL_HANG_FILE}.pid"
	exec sleep 30
fi

# The two nodes' state: the sink's level (AW_WPCTL_LEVEL_FILE, written by
# the gate for a level "set elsewhere"; else 0.56) and the muted nodes
# (AW_WPCTL_MUTES_FILE's words "sink" and "source"; absent, the source
# alone). A relative step moves a kept level (one the file holds) up to its
# limit; without one it leaves the default: the step checks read the
# command.
# A level PipeWire has yet to take (AW_WPCTL_LEVEL_FILE.next): an A2DP
# headset's announced volume lands 200 ms after the announcement
# (TRANSPORT_VOLUME_TIMEOUT_MSEC), and a read before that gets the level
# before; the gate writes it just ahead of the announcement.
level() {
	local l=0.56 f="${AW_WPCTL_LEVEL_FILE:-}"
	if [[ -n "$f" && -s "$f.next" ]] && awk -v n="$(date +%s.%N)" -v m="$(stat -c %.9Y "$f.next")" 'BEGIN { exit !(n - m >= 0.2) }'; then
		mv -f "$f.next" "$f"
	fi
	[[ -n "$f" && -s "$f" ]] && l="$(<"$f")"
	printf '%s' "$l"
}
muted() { # muted <sink|source>
	if [[ -n "${AW_WPCTL_MUTES_FILE:-}" && -e "$AW_WPCTL_MUTES_FILE" ]]; then
		grep -qxF "$1" "$AW_WPCTL_MUTES_FILE"
	else
		[[ $1 == source ]]
	fi
}
mute() { # mute <sink|source> toggle
	[[ -n "${AW_WPCTL_MUTES_FILE:-}" ]] || return 0
	local want n out=""
	muted "$1" && want=0 || want=1
	for n in sink source; do
		if [[ $n == "$1" ]]; then [[ $want == 1 ]] && out+="$n"$'\n'; elif muted "$n"; then out+="$n"$'\n'; fi
	done
	printf '%s' "$out" > "$AW_WPCTL_MUTES_FILE"
}

case "${1:-}" in
set-volume)
	# a step is 5%; presses during a set accumulate into the next one
	# (N*5%, capped at 100%); the limit is 1.0, or the level past it
	if [[ "$*" =~ ^set-volume\ -l\ (1\.0|[1-9]\.[0-9]{3})\ @DEFAULT_AUDIO_SINK@\ (5|[1-9][05]|100)%\+$ ]]; then
		[[ -n "${AW_WPCTL_LEVEL_FILE:-}" && -s "$AW_WPCTL_LEVEL_FILE" ]] &&
			awk -v l="$(level)" -v s="${BASH_REMATCH[2]}" -v m="${BASH_REMATCH[1]}" 'BEGIN { v = l + s / 100; if (v > m) v = m; printf "%.2f\n", v }' > "$AW_WPCTL_LEVEL_FILE.new" &&
			mv "$AW_WPCTL_LEVEL_FILE.new" "$AW_WPCTL_LEVEL_FILE"
	elif [[ "$*" =~ ^set-volume\ @DEFAULT_AUDIO_SINK@\ (5|[1-9][05]|100)%-$ ]]; then
		[[ -n "${AW_WPCTL_LEVEL_FILE:-}" && -s "$AW_WPCTL_LEVEL_FILE" ]] &&
			awk -v l="$(level)" -v s="${BASH_REMATCH[1]}" 'BEGIN { v = l - s / 100; if (v < 0) v = 0; printf "%.2f\n", v }' > "$AW_WPCTL_LEVEL_FILE.new" &&
			mv "$AW_WPCTL_LEVEL_FILE.new" "$AW_WPCTL_LEVEL_FILE"
	else
		exit 64
	fi
	sleep 0.05
	;;
set-mute)
	[[ "$*" =~ ^set-mute\ @DEFAULT_AUDIO_(SINK|SOURCE)@\ toggle$ ]] || exit 64
	node=sink
	[[ ${BASH_REMATCH[1]} == SOURCE ]] && node=source
	mute "$node" toggle
	;;
get-volume)
	if [[ -n "${AW_WPCTL_FLOOD_FILE:-}" && -e "$AW_WPCTL_FLOOD_FILE" ]]; then
		# The reader must stop this producer at its retained-output cap: it
		# closes the pipe (recorded below, SIGPIPE ignored so the loop sees
		# EPIPE) and kills the child; either way it is gone, not running to
		# a timeout.
		trap '' PIPE
		printf '%s\n' "$$" > "${AW_WPCTL_FLOOD_FILE}.pid"
		while printf 'Volume: 0.56\n' 2>/dev/null; do :; done
		printf 'closed\n' > "${AW_WPCTL_FLOOD_FILE}.closed"
		exit 0
	fi
	case "${2:-}" in
	"@DEFAULT_AUDIO_SINK@") printf 'Volume: %s%s\n' "$(level)" "$(muted sink && printf ' [MUTED]')" ;;
	"@DEFAULT_AUDIO_SOURCE@") printf 'Volume: 1.00%s\n' "$(muted source && printf ' [MUTED]')" ;;
	*) exit 64 ;;
	esac
	;;
*) exit 64 ;;
esac
