#!/usr/bin/env bash
set -u

LOG=${HYPROSD_WPCTL_LOG:?}
printf '%s\n' "$*" >> "$LOG"
if [[ -n "${HYPROSD_WPCTL_HANG_FILE:-}" && -e "$HYPROSD_WPCTL_HANG_FILE" ]]; then
	printf '%s\n' "$$" > "${HYPROSD_WPCTL_HANG_FILE}.pid"
	exec sleep 30
fi

case "${1:-}" in
set-volume)
	case "$*" in
	"set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+"|"set-volume @DEFAULT_AUDIO_SINK@ 5%-") ;;
	*) exit 64 ;;
	esac
	sleep 0.05
	;;
set-mute)
	case "$*" in
	"set-mute @DEFAULT_AUDIO_SINK@ toggle"|"set-mute @DEFAULT_AUDIO_SOURCE@ toggle") ;;
	*) exit 64 ;;
	esac
	;;
get-volume)
	case "${2:-}" in
	"@DEFAULT_AUDIO_SINK@") printf 'Volume: 0.56\n' ;;
	"@DEFAULT_AUDIO_SOURCE@") printf 'Volume: 1.00 [MUTED]\n' ;;
	*) exit 64 ;;
	esac
	;;
*) exit 64 ;;
esac
