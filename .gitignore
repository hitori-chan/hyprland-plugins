# built plugin artifacts — hyprpm builds these in its own cache on `hyprpm update`
*.so
*.tmp
.build/
.build-gate/
.build-test/

# local agent files (the tracked contract is AGENTS.md at the root)
CLAUDE.md
HANDOFF.md
TODO.md
.claude/

# local visual studies; keep generated demos out of repository history
docs/demos/
screenshots/

# devtools — nested-Hyprland test tooling: track the sources, not the
# build artifacts (fixture binaries + the wayland-scanner protocol glue)
devtools/vptr
devtools/vptr-proto.c
devtools/vptr-proto.h
devtools/vkbd
devtools/vkbd-proto.c
devtools/vkbd-proto.h
devtools/input-capture
devtools/input-capture-proto.c
devtools/input-capture-proto.h
devtools/cliphold
devtools/cliphold-proto.c
devtools/cliphold-proto.h
devtools/fixwin
devtools/fixwin-proto.c
devtools/fixwin-protocol.h
devtools/splashwin
devtools/fake-sni

# Planning, audit, and implementation-report documents (local only,
